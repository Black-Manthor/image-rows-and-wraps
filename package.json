{
	"name": "image-rows-and-wraps",
	"version": "0.1.2",
	"description": "Arrange images side by side in rows or wrap text around them, with the same layout in Live Preview, Reading view and PDF.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node tests/registro-comando.mjs build",
		"check:latest": "node tests/registro-comando.mjs check:latest",
		"check:secrets": "node tests/gitleaks-check.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "node tests/registro-comando.mjs lint",
		"test": "tsc -p tsconfig.tests.json && node tests/run.mjs",
		"test:browser": "node --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/registro-reporter.mjs --test-reporter-destination=stderr tests/browser.mjs",
		"test:rows": "node --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/registro-reporter.mjs --test-reporter-destination=stderr tests/row-layout-browser.mjs",
		"test:obsidian": "npm run build && npm run check:latest && node --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/registro-reporter.mjs --test-reporter-destination=stderr tests/obsidian.mjs",
		"test:copertura": "node tests/copertura.mjs",
		"registro": "node tests/registro-riepilogo.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.63.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.0",
		"obsidian-latest": "npm:obsidian@latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
